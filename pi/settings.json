      "researcher": {
        "model": "openai-codex/gpt-5.5:high"
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.5:high"
      },
      "reviewer": {
        "model": "anthropic/claude-fable-5:high"
      },
      "worker": {
        "model": "openai-codex/gpt-5.5:xhigh"
      }
    }
  },
  "packages": [
    "npm:pi-screenshots-picker",
    "npm:@plannotator/pi-extension",
    {
      "source": "git:https://github.com/mitsuhiko/agent-stuff",
      "skills": [],
      "extensions": [
        "extensions/answer.ts",
        "extensions/btw.ts",
        "extensions/files.ts",
        "extensions/prompt-editor.ts",
        "extensions/review.ts",
        "extensions/session-breakdown.ts",
        "extensions/split-fork.ts",
        "extensions/todos.ts"
      ],
      "themes": []
    },
    "npm:pi-perplexity",
    "git:https://github.com/badlogic/pi-diff-review",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:pi-mcp-adapter",
    "npm:pi-rtk-optimizer",
    "npm:pi-context-usage",
    "npm:pi-cache-graph",
    "npm:pi-codex-goal",
    "npm:@feniix/pi-exa",
    "npm:@ff-labs/pi-fff",
    "npm:@tintinweb/pi-subagents"
