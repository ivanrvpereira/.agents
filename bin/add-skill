#!/usr/bin/env bash
set -euo pipefail

AGENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
    cat <<EOF
Usage: $(basename "$0") <skill-name-or-path>

Validate a local skill under skills/.

Examples:
  $(basename "$0") my-skill         # Find and validate skills/**/my-skill
  $(basename "$0") on-demand/acli   # Validate skills/on-demand/acli
EOF
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

if [ "$1" = "--help" ]; then
    usage
    exit 0
fi

SKILL_REF="$1"

if [ -d "$SKILL_REF" ]; then
    SKILL_DIR="$(cd "$SKILL_REF" && pwd)"
elif [ -d "$AGENTS_DIR/skills/$SKILL_REF" ]; then
    SKILL_DIR="$AGENTS_DIR/skills/$SKILL_REF"
else
    matches=()
    while IFS= read -r match; do
        matches+=("$match")
    done < <(find -L "$AGENTS_DIR/skills" -path "*/$SKILL_REF/SKILL.md" -type f | sort)
    if [ "${#matches[@]}" -eq 1 ]; then
        SKILL_DIR="$(dirname "${matches[0]}")"
    elif [ "${#matches[@]}" -gt 1 ]; then
        echo "Error: multiple skills named $SKILL_REF:" >&2
        printf '  %s\n' "${matches[@]%/SKILL.md}" >&2
        exit 1
    else
        SKILL_DIR="$AGENTS_DIR/skills/$SKILL_REF"
    fi
fi

if [ ! -d "$SKILL_DIR" ]; then
    echo "Error: skill directory not found: $SKILL_DIR" >&2
    exit 1
fi

if [ ! -f "$SKILL_DIR/SKILL.md" ]; then
    echo "Error: no SKILL.md found in $SKILL_DIR" >&2
    exit 1
fi

echo "OK: $SKILL_DIR"
echo "Run: bin/sync --dry-run"
echo "Then: bin/sync"
