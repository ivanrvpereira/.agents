#!/usr/bin/env bash
set -euo pipefail

AGENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
    cat <<EOF
Usage: $(basename "$0") <skill-name>

Validate a local skill under skills/<skill-name>.

Examples:
  $(basename "$0") my-skill         # Validate skills/my-skill
EOF
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

if [ "$1" = "--help" ]; then
    usage
    exit 0
fi

SKILL_NAME="$1"
SKILL_DIR="$AGENTS_DIR/skills/$SKILL_NAME"

if [ ! -d "$SKILL_DIR" ]; then
    echo "Error: skill directory not found: $SKILL_DIR" >&2
    exit 1
fi

if [ ! -f "$SKILL_DIR/SKILL.md" ]; then
    echo "Error: no SKILL.md found in $SKILL_DIR" >&2
    exit 1
fi

echo "OK: $SKILL_DIR"
echo "Run: bin/sync --dry-run"
echo "Then: bin/sync"
